# UI Testing Framework - Environment Configuration
# Copy to .env and add your API keys

# LLM API Keys (at least one required for Steps 2 & 3)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default LLM Settings
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Browser Settings
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30

# Test Execution
MAX_PARALLEL_WORKERS=4
TEST_TIMEOUT=60
RETRY_FAILED_TESTS=true
MAX_RETRIES=2