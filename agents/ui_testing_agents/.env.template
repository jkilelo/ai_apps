# V2 LLM-Native System Environment Variables
# Copy this file to .env and add your API keys

# Required: At least ONE of these API keys must be set
# Get your keys from:
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# Google: https://makersuite.google.com/app/apikey

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google API Key (for Gemini models)
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Preferred LLM provider (openai, anthropic, google)
# If not set, system will try available providers in order
PREFERRED_LLM_PROVIDER=openai

# Optional: Model preferences
OPENAI_MODEL=gpt-3.5-turbo
ANTHROPIC_MODEL=claude-3-haiku-20240307
GOOGLE_MODEL=gemini-1.5-flash

# Optional: API settings
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7