# Ignore sensitive or temporary files in .claude directory

# Cache and temporary files
cache/
*.cache
*.tmp
*.temp

# Performance metrics (may contain sensitive data)
metrics.jsonl
reports/

# Generated files
generated_*.md
*.optimized.md
test_prompt.txt
test_prompt.optimized.md

# Security reports (may contain sensitive findings)
*.security.json
*.secure.py
*.security_test.py

# Local configuration overrides
local_settings.json
*.local.json

# Backup files
*.backup
*.bak
*.old

# Log files
*.log
logs/

# But explicitly include important configuration
!settings.json
!advanced_optimizations.json
!prompt_templates/
!commands/
!PROMPT_ENGINEERING_GUIDE.md
!README_ADVANCED_2025.md
!prompt_analysis_report.md
!prompt_optimizer.py
!performance_monitor.py
!claude_advanced.py
!automation_scripts.py