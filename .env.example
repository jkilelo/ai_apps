# Environment configuration for the AI system

# UI Web Auto Testing API Configuration
UI_WEB_AUTO_TESTING_PORT=8002
FASTAPI_HOST=localhost
FASTAPI_PORT=8003

# API Keys (replace with your actual keys)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
GOOGLE_GENAI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=o3
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-opus-4-20250514

# MongoDB Configuration
# You can use either a full connection string or individual components

# Option 1: Full connection string (recommended for internet access)
MONGODB_CONNECTION_STRING=mongodb://username:password@your_host:27017/your_database?authSource=admin

# Option 2: Individual connection components (for programmatic access)
MONGODB_HOST=your_mongodb_host
MONGODB_PORT=27017
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DATABASE=your_database_name

# Security settings
MONGODB_SSL=false
MONGODB_AUTH_SOURCE=admin

# MongoDB Web Interface (Mongo Express)
# Access via: https://your-mongo-interface.com
# Username: your_username / Password: your_password
