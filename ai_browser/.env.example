# AI-First Smart Browser Environment Variables
# Copy this file to .env and fill in your actual values

# LLM Provider API Keys (Priority order: XAI, then Gemini)
XAI_API_KEY=xai-...your-key-here...
GOOGLE_API_KEY=AIza...your-key-here...

# Container Services (Running in Podman)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
MEILISEARCH_HOST=localhost
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=test_master_key
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_DEVTOOLS=false
BROWSER_SLOWMO=0
BROWSER_TIMEOUT=30000
STEALTH_MODE=enabled

# Development Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO
CLAUDE_CODE_MAX_OUTPUT_TOKENS=128000

# Optional: Proxy Configuration
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional: Custom Paths
# SCREENSHOTS_DIR=./screenshots
# HAR_FILES_DIR=./har_files
# LOGS_DIR=./logs