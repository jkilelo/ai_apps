# NEXUS Browser Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Environment Mode (development, staging, production)
ENVIRONMENT=development

# Debug Mode (true/false)
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Google Generative AI (Gemini) Configuration
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_TOKENS=4096

# Default AI Provider (openai, google, anthropic)
DEFAULT_AI_PROVIDER=google

# =============================================================================
# BROWSER CONFIGURATION
# =============================================================================

# Browser Type (chromium, firefox, webkit)
BROWSER_TYPE=chromium

# Browser Settings
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
BROWSER_TIMEOUT=30000
BROWSER_DOWNLOAD_PATH=./downloads

# Stealth Mode
BROWSER_STEALTH_MODE=true
BROWSER_BLOCK_ADS=true
BROWSER_BLOCK_TRACKERS=true

# =============================================================================
# QUANTUM CONFIGURATION
# =============================================================================

# Quantum Backend (qiskit, pennylane, cirq)
QUANTUM_BACKEND=qiskit
QUANTUM_SIMULATOR=aer_simulator
QUANTUM_NUM_QUBITS=10
QUANTUM_SHOTS=1024
QUANTUM_OPTIMIZATION_LEVEL=3

# IBM Quantum Experience (if using real quantum hardware)
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here
IBM_QUANTUM_HUB=ibm-q
IBM_QUANTUM_GROUP=open
IBM_QUANTUM_PROJECT=main

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_browser
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_POOL_SIZE=10

# MongoDB Configuration (for holographic storage)
MONGODB_URL=mongodb://localhost:27017/nexus_browser
MONGODB_DATABASE=nexus_browser
MONGODB_COLLECTION=holographic_memory

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log Format (json, plain, structured)
LOG_FORMAT=structured

# Log Output (console, file, both)
LOG_OUTPUT=both

# Log File Settings
LOG_FILE_PATH=./logs/nexus.log
LOG_FILE_MAX_SIZE=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=5
LOG_ROTATION=midnight

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret Key (generate a strong random key)
JWT_SECRET_KEY=your_jwt_secret_key_here_must_be_very_long_and_random
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# =============================================================================
# MONITORING & METRICS
# =============================================================================

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# NEURAL MONOLITH PATTERN CONFIGURATION
# =============================================================================

# MCP Neural Configuration
MCP_NEURAL_LAYERS=7
MCP_NEURAL_NODES_PER_LAYER=512
MCP_NEURAL_ACTIVATION=relu
MCP_NEURAL_LEARNING_RATE=0.001
MCP_NEURAL_BATCH_SIZE=32

# Consciousness Parameters
CONSCIOUSNESS_THRESHOLD=0.85
CONSCIOUSNESS_UPDATE_INTERVAL=1000  # milliseconds
CONSCIOUSNESS_MEMORY_SIZE=10000

# Evolution Parameters
EVOLUTION_POPULATION_SIZE=100
EVOLUTION_MUTATION_RATE=0.01
EVOLUTION_CROSSOVER_RATE=0.7
EVOLUTION_SELECTION_PRESSURE=2.0

# Holographic Storage
HOLOGRAM_DIMENSIONS=1024
HOLOGRAM_COMPRESSION_RATIO=0.1
HOLOGRAM_REDUNDANCY_FACTOR=3

# =============================================================================
# TASK QUEUE CONFIGURATION
# =============================================================================

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Hot Reload
HOT_RELOAD_ENABLED=true
HOT_RELOAD_WATCH_DIRS=["./", "./templates", "./static"]

# Testing
TEST_MODE=false
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/nexus_test
TEST_REDIS_URL=redis://localhost:6379/15

# Profiling
PROFILING_ENABLED=false
PROFILING_OUTPUT_DIR=./profiling

# =============================================================================
# FEATURE FLAGS
# =============================================================================

FEATURE_QUANTUM_ENABLED=true
FEATURE_CONSCIOUSNESS_ENABLED=true
FEATURE_EVOLUTION_ENABLED=true
FEATURE_HOLOGRAPHIC_ENABLED=true
FEATURE_MCP_NEURAL_ENABLED=true
FEATURE_EXPERIMENTAL=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# GitHub API
GITHUB_API_TOKEN=your_github_token_here

# Slack Notifications
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_CHANNEL=#nexus-alerts

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=nexus@example.com

# =============================================================================
# PATHS AND DIRECTORIES
# =============================================================================

# Data Directories
DATA_DIR=./data
CACHE_DIR=./cache
TEMP_DIR=./temp
BACKUP_DIR=./backups

# Static Files
STATIC_DIR=./static
TEMPLATES_DIR=./templates
UPLOADS_DIR=./uploads

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Thread Pool Settings
THREAD_POOL_SIZE=10
MAX_WORKERS=20

# Connection Pool Settings
CONNECTION_POOL_SIZE=50
CONNECTION_TIMEOUT=30

# Cache Settings
CACHE_TTL=3600  # seconds
CACHE_MAX_SIZE=1000

# =============================================================================
# END OF CONFIGURATION
# =============================================================================

# Note: Remember to keep this template updated when adding new configuration options
# Version: 1.0.0
# Last Updated: 2025-08-31